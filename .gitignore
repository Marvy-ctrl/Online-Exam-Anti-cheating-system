node_modules
frontend/.next

# Locally-stored webcam snapshots. These are real biometric captures and must
# never be committed. The directory is recreated on boot by os.makedirs() in
# backend/src/__init__.py:58 and backend/src/core/storage.py:119, so nothing
# needs to track it. Matches backend/uploads/ at any depth.
uploads/
# Finder/rsync duplicate-name variants, e.g. "uploads 2/", "uploads copy/".
uploads[ ]*/
*[ ]2/

# Redis persistence file — can contain queued task payloads.
dump.rdb
*.rdb

# Local scratch/experiment area. The collaborator tracks analysis scripts here
# intentionally (locustfile.py, generate_flowchart.py, ...), so only ignore the
# data/output that collects alongside them — not the code.
scratch/uploads/
scratch/**/*.jpg
scratch/**/*.png
scratch/**/*.csv
scratch/**/*.rdb

# Local load-test credentials, virtual environment, and raw measurements.
performance/.env
performance/.venv/
performance/results/*
!performance/results/.gitkeep

# Thesis/report drafts — collaborator's convention (added upstream in 26e11ca).
report/

# Env files at ANY depth. The bare `.env` on line 1 only matches the repo root,
# so nested secrets (frontend/.env.local, backend/src/.env) were unprotected.
**/.env
**/.env.*
!**/.env.example
!.env.production.example
performance/.env.example