DATABASE_URL=postgresql+asyncpg://examloc:change_me@localhost:5432/examloc_db
DB_SSL=false

JWT_SECRET_EXAMINER=replace_with_a_long_random_secret
JWT_SECRET_STUDENT=replace_with_a_different_long_random_secret
JWT_ALGORITHM=HS256

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

DOMAIN=http://localhost:8000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace_with_a_local_minio_secret
MINIO_BUCKET=snapshots
MINIO_SECURE=false

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=no-reply@example.com

CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

FACE_SIMILARITY_THRESHOLD=0.40
FACE_ENROLLMENT_MIN_PASSING=3
SNAPSHOT_RETENTION_DAYS=7

ENCRYPTION_KEY=replace_with_64_hex_characters
