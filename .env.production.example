# ─────────────────────────────────────────────────────────────────────────────
# ExamLoc — STAGING env for the VPS. Copy to `.env` at the repo root, fill in,
# then: docker compose -f docker-compose.prod.yml up -d --build
#
# IMPORTANT: this file belongs at the REPO ROOT only.
# Do NOT copy it to backend/src/.env — config.py sets extra="forbid", and the
# POSTGRES_* keys below are not declared in Settings, so pydantic would refuse
# to boot. In Docker the root .env is all you need (compose passes it through
# via env_file, and undeclared *process* env vars are ignored safely).
#
# Generate every secret below with:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# The host MUST be `postgres` — that is the compose service name.
# (The old .env.example said @db:5432, which does not resolve.)
POSTGRES_USER=examloc
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
POSTGRES_DB=examloc_db
DATABASE_URL=postgresql+asyncpg://examloc:CHANGE_ME_openssl_rand_hex_32@postgres:5432/examloc_db
# false: Postgres is on the internal Docker network, not traversing the internet.
DB_SSL=false

# ─── Redis ───────────────────────────────────────────────────────────────────
# Use a hex password (no special chars) so it needs no URL-encoding.
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_32
REDIS_URL=redis://:CHANGE_ME_openssl_rand_hex_32@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_openssl_rand_hex_32@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_openssl_rand_hex_32@redis:6379/0

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Two DIFFERENT values. Note from the audit: AccessTokenBearer does not check
# the role claim, so today the student secret is admin-equivalent on routes that
# lack Depends(role). Keeping them distinct still limits the blast radius.
JWT_SECRET_EXAMINER=CHANGE_ME_openssl_rand_hex_32
JWT_SECRET_STUDENT=CHANGE_ME_openssl_rand_hex_32_DIFFERENT
JWT_ALGORITHM=HS256

# ─── App URLs ────────────────────────────────────────────────────────────────
# DOMAIN is the PUBLIC backend origin. It is embedded into snapshot image URLs
# (core/storage.py:152) and audit URLs (exam_session/service.py:818) — if this
# is wrong, the examiner dashboard shows broken images.
DOMAIN=https://api.examloc.xyz
# FRONTEND_URL drives the CORS allowlist AND every emailed enrollment/exam link.
# Must exactly match the Vercel origin, no trailing slash.
FRONTEND_URL=https://examloc.xyz

# ─── Cookies ─────────────────────────────────────────────────────────────────
# MUST be true here: the site is HTTPS end to end. Left false, admin session
# cookies are accepted over plaintext HTTP too.
COOKIE_SECURE=true

# ─── MinIO ───────────────────────────────────────────────────────────────────
# Internal only — no host ports are published. Snapshots are served through the
# API proxy, so the browser never talks to MinIO directly.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=examloc_minio
MINIO_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
MINIO_BUCKET=snapshots
# false because the API↔MinIO hop stays inside the Docker network.
MINIO_SECURE=false

# ─── SMTP ────────────────────────────────────────────────────────────────────
# Gmail requires an App Password, not your account password.
# Without working SMTP, enrollment and exam links cannot be delivered.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=you@gmail.com

# ─── Cloudinary ──────────────────────────────────────────────────────────────
# Required by config.py even though MinIO handles snapshots. Placeholders are
# fine for staging — the app will boot, it just cannot use Cloudinary.
CLOUDINARY_CLOUD_NAME=unused_in_staging
CLOUDINARY_API_KEY=unused_in_staging
CLOUDINARY_API_SECRET=unused_in_staging

# ─── Face verification ───────────────────────────────────────────────────────
FACE_SIMILARITY_THRESHOLD=0.40
FACE_ENROLLMENT_MIN_PASSING=3

# ─── Encryption ──────────────────────────────────────────────────────────────
# Exactly 64 hex chars. Required by config.py, but core/crypto.py is currently
# dead code — embeddings are stored as plaintext float8[]. Set it properly
# anyway so the value is real if the module is ever re-wired.
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# ─── Host port for the API (loopback only) ───────────────────────────────────
# Change if 8100 is already taken by the other project on this VPS.
API_HOST_PORT=8100
