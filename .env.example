# ─── Database (matches the 'db' service name in docker-compose) ───────────────
POSTGRES_USER=examloc
POSTGRES_PASSWORD=changeme
POSTGRES_DB=examloc_db
DATABASE_URL=postgresql+asyncpg://examloc:changeme@db:5432/examloc_db

# ─── Redis (matches the 'redis' service name in docker-compose) ───────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_EXAMINER=replace_with_a_long_random_secret
JWT_SECRET_STUDENT=replace_with_another_long_random_secret
JWT_ALGORITHM=HS256

# ─── App URLs ─────────────────────────────────────────────────────────────────
DOMAIN=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ─── MinIO (matches the 'minio' service name in docker-compose) ───────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=snapshots
MINIO_SECURE=false

# ─── SMTP (email) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=you@gmail.com

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Face verification ────────────────────────────────────────────────────────
FACE_SIMILARITY_THRESHOLD=0.40
FACE_ENROLLMENT_MIN_PASSING=3
SNAPSHOT_RETENTION_DAYS=7

# ─── Encryption (generate: python -c "import secrets; print(secrets.token_hex(32))") ──
ENCRYPTION_KEY=replace_with_64_hex_chars

# ─── DB SSL (set true in production) ─────────────────────────────────────────
DB_SSL=false
